# CognoDB Cloud Database Credentials
# Sign up and create a free (c0) instance at https://console.cognodb.com
# Example URI format: bolt+s://<instance-id>.databases.cognodb.cloud

COGNO_URI=bolt+s://your-instance.databases.cognodb.cloud
COGNO_USER=cognodb
COGNO_PASSWORD=your_generated_password

# Server Configuration
PORT=3098
